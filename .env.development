# Application
APP_NAME="MSWMS - Development"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - SQLite for local development
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcast
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Cache
CACHE_STORE=file
CACHE_PREFIX=mswms_dev

# Mail - Log all emails in development
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# Rate Limiting - Relaxed for development
RATE_LIMIT_API=120
RATE_LIMIT_ADMIN=200
RATE_LIMIT_HEAVY=500
RATE_LIMIT_AUTH=60

# Webhooks
WEBHOOK_SECRET=dev_webhook_secret_key
WEBHOOK_TIMEOUT=30
WEBHOOK_RETRY_ATTEMPTS=3

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90

# Export Settings
EXPORT_PATH=storage/app/exports
EXPORT_RETENTION_HOURS=24

# AWS (Optional for local)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Security Settings (OWASP A05)
# CSP_MODE=auto will use 'legacy' mode for local/development environments
CSP_MODE=auto
CSP_ENABLED=true
CSP_REPORT_ONLY=false

# Debug mode protection (disabled for development)
SECURITY_BLOCK_DEBUG_ACCESS=false
SECURITY_LOG_EVENTS=true
SECURITY_LOG_LEVEL=debug

# Vite
VITE_APP_NAME="${APP_NAME}"
