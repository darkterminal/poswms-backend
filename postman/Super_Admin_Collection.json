                {
                  "key": "per_page",
                  "value": "15"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "sort_by",
                  "value": "created_at",
                  "disabled": true
                },
                {
                  "key": "sort_direction",
                  "value": "desc",
                  "disabled": true
                }
              ]
            },
            "description": "Get paginated list of all tenants with optional filtering"
          }
        },
