# Testing Environment Configuration
# This file is used when running tests with APP_ENV=testing

APP_ENV=testing
APP_DEBUG=true
APP_KEY=base64:b4a9KIImpINh2XKhz9gTmw44zQOxkNPsaKxYV7msa4U=

# Database - Separate SQLite for testing (isolated from main database)
DB_CONNECTION=sqlite
DB_DATABASE=database/testing.sqlite

# Cache and Session (use array for faster tests)
CACHE_STORE=array
SESSION_DRIVER=array

# Mail (don't send emails in tests)
MAIL_MAILER=array

# Queue (sync for testing)
QUEUE_CONNECTION=sync

# Disable packages
TELESCOPE_ENABLED=false
PULSE_ENABLED=false
NIGHTWATCH_ENABLED=false

# Logging
LOG_CHANNEL=null
LOG_LEVEL=error
