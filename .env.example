APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================
# SECURITY SETTINGS (OWASP A05: Security Misconfiguration)
# ==========================================

# Content Security Policy (CSP) Configuration
# Modes: auto, legacy, strict, custom
# - auto: Automatically selects based on APP_ENV (local/development=legacy, staging/production=strict)
# - legacy: Allows 'unsafe-inline' and 'unsafe-eval' (for development only)
# - strict: Uses nonce-based loading (recommended for production)
# - custom: Uses custom directives from config/csp.php
CSP_MODE=auto

# Enable/disable CSP headers entirely (not recommended for production)
CSP_ENABLED=true

# Use report-only mode for testing policies before enforcement
CSP_REPORT_ONLY=false

# URI to receive CSP violation reports (optional)
# CSP_REPORT_URI=https://your-domain.com/csp-report

# Security: Block debug access in production
# Set to true to block non-admin users when APP_DEBUG=true in production
SECURITY_BLOCK_DEBUG_ACCESS=false

# Comma-separated list of trusted IPs allowed even when debug is enabled
# SECURITY_TRUSTED_IPS=127.0.0.1,192.168.1.1

# Log security events
SECURITY_LOG_EVENTS=true
SECURITY_LOG_LEVEL=warning

# ==========================================
# SSRF PROTECTION (OWASP A10: Server-Side Request Forgery)
# ==========================================

# Enable strict mode for enhanced SSRF protection
# When true: enables DNS rebinding protection, redirect validation
# Set to false for development with internal URLs
SSRF_STRICT_MODE=true

# Enable allowlist-only mode (highest security)
# When true, only domains in SSRF_ALLOWED_DOMAINS are permitted
SSRF_ALLOWLIST_ENABLED=false

# Comma-separated list of allowed domains for webhooks
# Supports wildcards: *.example.com matches all subdomains
# Example: SSRF_ALLOWED_DOMAINS=hooks.slack.com,*.example.com,api.github.com
SSRF_ALLOWED_DOMAINS=

# Enable DNS rebinding protection (adds ~100ms delay to validation)
SSRF_DNS_REBINDING_PROTECTION=true

# Enable redirect validation (makes HEAD request to check destination)
SSRF_VALIDATE_REDIRECTS=false

# Logging configuration
SSRF_LOG_BLOCKED=true
SSRF_LOG_VALIDATED=false
SSRF_LOG_LEVEL=warning

# Enable audit logging for SSRF events
SSRF_AUDIT_LOGGING=true

# Testing mode (relaxes some checks for local development)
SSRF_TESTING_MODE=false

VITE_APP_NAME="${APP_NAME}"
