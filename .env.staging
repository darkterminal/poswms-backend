# Application
APP_NAME="MSWMS - Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.mswms.example.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache

LOG_CHANNEL=errorlog
LOG_LEVEL=info

# Database - PostgreSQL for staging
DB_CONNECTION=pgsql
DB_HOST=staging-db.example.com
DB_PORT=5432
DB_DATABASE=mswms_staging
DB_USERNAME=mswms_staging_user
DB_PASSWORD=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.mswms.example.com

# Broadcast
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

# Cache
CACHE_STORE=redis
CACHE_PREFIX=mswms_staging

# Redis
REDIS_HOST=staging-redis.example.com
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=tls

# Sanctum
SANCTUM_STATEFUL_DOMAINS=staging.mswms.example.com

# Rate Limiting
RATE_LIMIT_API=100
RATE_LIMIT_ADMIN=150
RATE_LIMIT_HEAVY=300
RATE_LIMIT_AUTH=50

# Webhooks
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT=30
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_LOG_FAILURES=true

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=180

# Export Settings
EXPORT_PATH=s3://mswms-staging-exports/exports
EXPORT_RETENTION_HOURS=48

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=mswms-staging
AWS_USE_PATH_STYLE_ENDPOINT=false

# Security Settings (OWASP A05)
# CSP_MODE=auto will use 'strict' mode for staging/production environments
CSP_MODE=auto
CSP_ENABLED=true
CSP_REPORT_ONLY=true

# Debug mode protection (enabled for staging)
SECURITY_BLOCK_DEBUG_ACCESS=true
SECURITY_LOG_EVENTS=true
SECURITY_LOG_LEVEL=warning

# Vite
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
